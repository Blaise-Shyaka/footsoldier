<p>
  <%= link_to 'Sales Per Day', engen_reports_sales_per_day_path %> |
  <%= link_to 'Sales Per Day Per Promoter', engen_reports_sales_per_promoter_path %>
  <%= link_to "Download All Chef W'umujyis", engen_reports_download_csv_path %>
</p>

<h1>Daily Sales Per Promoter</h1>

<table>
  <thead>
    <tr>
      <td>Date</td>
      <td>Full Names</td>
      <td>Petrol Station</td>
      <td>Sales Value (Rwf) </td>
    <tr>
  </thead>
  <tbody>
    <% @promoters_sales.each do |promoter| %>
      <% promoter[:sales].each do |key, value| %>
        <tr>
          <td><%= key %></td>
          <td><%= promoter[:promoter_name] %></td>
          <td><%= promoter[:station] %></td>
          <td><%= number_to_currency(value, unit: "", separator: ",", precision: 0) %></td>
        </tr>
      <% end %>
    <% end %>
  <tbody>
</table>