<p>
  <%= link_to 'Sales Per Day', engen_reports_sales_per_day_path %> |
  <%= link_to 'Sales Per Day Per Promoter', engen_reports_sales_per_promoter_path %>
</p>

<table>
  <thead>
    <tr>
      <td>Date</td>
      <td>Sales Value (Rwf)</td>
    </tr>
  </thead>
  <tbody>
    <% @sales.each do |key, value| %>
      <tr>
        <td><%= key %><td>
        <td><%= number_to_currency(value, unit: "", separator: ",", precision: 0) %><td>
      </tr>
    <% end %>
  </tbody>
</table>