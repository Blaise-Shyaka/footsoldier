<p id="notice"><%= notice %></p>

<h1>Chef Wumujyis</h1>

<%= link_to 'New Chef Wumujyi', new_chef_wumujyi_path %>

<table>
  <thead>
    <tr>
      <th>Vehicle type</th>
      <th>Fueled value</th>
      <th>Plate number</th>
      <th>Customer name</th>
      <th>Telephone number</th>
      <th>Service station name</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @chef_wumujyis.each do |chef_wumujyi| %>
      <tr>
        <td><%= chef_wumujyi.vehicle_type %></td>
        <td><%= chef_wumujyi.fueled_value %></td>
        <td><%= chef_wumujyi.plate_number %></td>
        <td><%= chef_wumujyi.customer_name %></td>
        <td><%= chef_wumujyi.telephone_number %></td>
        <td><%= chef_wumujyi.service_station_name %></td>
        <td><%= link_to 'Show', chef_wumujyi %></td>
        <td><%= link_to 'Destroy', chef_wumujyi, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Chef Wumujyi', new_chef_wumujyi_path %>
