<h1>New Union Pay Merchant</h1>

<%= simple_form_for @union_pay_merchant do |f| %>
  <%= f.input :merchant_name %>
  <%= f.input :address %>
  <%= f.input :merchant_category, 
              collection: [
                'Shopping and souvenir stores',
                'Restaurants or bars',
                'Hotels',
                'Supermarkets, convenient stores, or wholesales',
                'Car rentals',
                'Entertainment and scenic spots',
                'Transportation'
                ], 
                prompt: "Select merchant category" %>
  <%= f.input :merchant_accept_international_payment, 
              collection: [
                'Yes',
                'No - Local card only',
                'No - Local digital wallet only',
                'No - Local bank card and digital wallet only',
                'No - Cash only'
                ],
                label: "Does the merchant accept international payment solutions (bank cards or digital wallets)?",
                prompt: "Select one option" %>
  <%= f.input :merchant_has_multiple_acquirers,
              as: :check_boxes,
              collection: [['1', 'Equity'], [2, 'KCB'], [3, 'COGEBANQUE'], [4, 'ECOBANK'], [5, 'BK'], [6, 'BPR']], label_method: :second, value_method: :first, 
              label: 'Does the merchant has multiple acquirers?'%>
  <h4>Contactless card acceptance testing (Skip this section)</h4>
  <%= f.input :contactless_upi_accepted, 
              collection: [
                'The cashier stated UnionPay Accepted/ Test not allowed',
                'Cashier not sure or stated UnionPay not Accepted/ Test not allowed',
                'The cashier stated UnionPay accepted/ Tested',
                'Cashier not sure or stated UnionPay not Accepted/ Tested',
                'Not active yet'
                ],
                label: "Contactless UnionPay accepted and tested?",
                selected: 'Not active yet',
                prompt: "Select one option" %>
  <%= f.input :contactless_why_upi_not_accepted, 
              collection: [
                'Interview refused by the merchant',
                'The cashier does not know how to use UnionPay',
                'No need for enabling UnionPay',
                'Do not know',
                'Not active yet'
                ],
                selected: 'Not active yet',
                label: "If you chose option 2 on the previous question, why is UnionPay contactless not accepted and test transactions not allowed?",
                prompt: "Select one option" %>
  <%= f.input :contactless_purchase_transaction_result, 
              collection: [
                'Approved',
                'Failed',
                'Test not allowed',
                'Not active yet'
                ],
                selected: 'Not active yet',
                label: "Contactless card purchase test transaction result?",
                prompt: "Select one option" %>
  <%= f.input :contactless_code, label: "Contactless transaction result code", placeholder: "Eg: 55, 51, ..." %>
  <%= f.input :contactless_other_card_schemes_accepted, 
              collection: [
                'VISA',
                'Mastercard',
                'both VISA and Mastercard',
                'Test not allowed',
                'Not active yet'
                ],
                selected: 'Not active yet',
                label: "Other contactless card schemes accepted?",
                prompt: "Select one option" %>
  <%= f.input :contactless_test_scenario, 
              collection: [
                'Mystery test',
                'Authentic test',
                'Not active yet'
                ],
                selected: 'Not active yet',
                label: "Contactless test transaction scenario?",
                prompt: "Select one option" %>
  <h4>Insert card into the POS and proceed with questions</h4>
  <%= f.input :chip_in_pos_upi_accepted, 
              collection: [
                'The cashier stated UnionPay Accepted/ Test not allowed',
                'Cashier not sure or stated UnionPay not Accepted/ Test not allowed',
                'The cashier stated UnionPay accepted/ Tested',
                'Cashier not sure or stated UnionPay not Accepted/ Tested',
                'Contactless succeeded'
                ],
                label: "UnionPay accepted and tested?",
                prompt: "Select one option" %>
  <%= f.input :chip_in_pos_why_upi_not_accepted, 
              collection: [
                'Interview refused by the merchant',
                'The cashier does not know how to use UnionPay',
                'No need for enabling UnionPay',
                'Do not know',
                'Contactless succeeded'
                ],
                label: "If you chose option 2 on the previous question, why is UnionPay not accepted and test transactions not allowed?",
                prompt: "Select one option" %>
  <%= f.input :chip_in_pos_purchase_transaction_result, 
              collection: [
                'Approved',
                'Failed',
                'Test not allowed',
                'Contactless succeeded'
                ],
                label: "Card purchase test transaction result?",
                prompt: "Select one option" %>
  <%= f.input :chip_in_pos_code, label: "Transaction result code", placeholder: "Eg: 55, 51, ..." %>
  <%= f.input :chip_in_pos_other_card_schemes_accepted, 
              collection: [
                'VISA',
                'Mastercard',
                'both VISA and Mastercard',
                'Test not allowed',
                'Contactless succeeded'
                ],
                label: "Card schemes accepted?",
                prompt: "Select one option" %>
  <%= f.input :chip_in_pos_test_scenario, 
              collection: [
                'Mystery test',
                'Authentic test',
                'Contactless succeeded'
                ],
                label: "Test transaction scenario?",
                prompt: "Select one option" %>
  <h4>If contactless and inserting card failed, please proceed with the following questions</h4>
  <%= f.input :swipe_upi_accepted, 
              collection: [
                'The cashier stated UnionPay Accepted/ Test not allowed',
                'Cashier not sure or stated UnionPay not Accepted/ Test not allowed',
                'The cashier stated UnionPay accepted/ Tested',
                'Cashier not sure or stated UnionPay not Accepted/ Tested',
                'Other tests succeeded'
                ],
                label: "UnionPay accepted and tested?",
                selected: 'Other tests succeeded',
                prompt: "Select one option" %>
  <%= f.input :swipe_why_upi_not_accepted, 
              collection: [
                'Interview refused by the merchant',
                'The cashier does not know how to use UnionPay',
                'No need for enabling UnionPay',
                'Do not know',
                'Other tests succeeded'
                ],
                selected: 'Other tests succeeded',
                label: "If you chose option 2 on the previous question, why is UnionPay not accepted and test transactions not allowed?",
                prompt: "Select one option" %>
  <%= f.input :swipe_purchase_transaction_result, 
              collection: [
                'Approved',
                'Failed',
                'Test not allowed',
                'Other tests succeeded'
                ],
                selected: 'Other tests succeeded',
                label: "Card purchase test transaction result?",
                prompt: "Select one option" %>
  <%= f.input :swipe_code, label: "Transaction result code", placeholder: "Eg: 55, 51, ..." %>
  <%= f.input :swipe_other_card_schemes_accepted, 
              collection: [
                'VISA',
                'Mastercard',
                'both VISA and Mastercard',
                'Test not allowed',
                'Other tests succeeded'
                ],
                selected: 'Other tests succeeded',
                label: "Other card schemes accepted?",
                prompt: "Select one option" %>
  <%= f.input :swipe_test_scenario, 
              collection: [
                'Mystery test',
                'Authentic test',
                'Other tests succeeded'
                ],
                selected: 'Other tests succeeded',
                label: "Test transaction scenario?",
                prompt: "Select one option" %>

  <h4>Decal/Signage Display</h4>

  <%= f.input :upi_decal_displayed_before_visit, 
              collection: [
                'Physical decal',
                'Electronic decal',
                'No UnionPay decal'
                ],
                label: "UnionPay decal displayed before the visit?",
                prompt: "Select one option" %>
  <%= f.input :upi_decal_displayed_after_visit, 
              collection: [
                'Yes',
                'No'
                ],
                label: "If you chose option 3 in the previous question, UnionPay decal posted after the visit?",
                prompt: "Select one option" %>
  <%= f.input :is_visa_or_mastercard_displayed, 
              collection: [
                'Both of them posted',
                'Only VISA decal posted',
                'Only Mastercard decal posted',
                'Neither of them posted'
                ],
                label: "VISA OR Mastercard decal displayed?",
                prompt: "Select one option" %>
  <%= f.input :is_contactless_mark_shown_upi_single_decal, 
              collection: [
                'Yes',
                'No'
                ],
                label: "The contactless mark is shown with UnionPay single decal?",
                prompt: "Select one option" %>
  <%= f.input :is_visa_or_mastercard_contactless_mark_shown_on_single_decal, 
              collection: [
                'Both of them shown',
                'Only VISA contactless shown',
                'Only Mastercard contactless shown',
                'Neither of them shown'
                ],
                label: "VISA or Mastercard Contactless mark is shown on a single decal of Visa or Mastercard?",
                prompt: "Select one option" %>
  <%= f.input :is_contactless_mark_shown_on_integrated_decal, 
              collection: [
                'Yes',
                'No'
                ],
                label: "The contactless mark is shown on the Integrated Decal of multiple card schemes?",
                prompt: "Select one option" %>
  <%= f.input :special_comments, as: :text %>
  <%= f.button :submit %>
<% end %>

<%= link_to 'Back', union_pay_merchants_path %>
