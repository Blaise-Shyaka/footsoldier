<p id="notice"><%= notice %></p>

<h1>Union Pay Merchants</h1>

<table>
  <thead>
    <tr>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @union_pay_merchants.each do |union_pay_merchant| %>
      <tr>
        <td><%= union_pay_merchant.merchant_name %><td>
        <td><%= link_to 'Edit Merchant', edit_union_pay_merchant_path(union_pay_merchant.id) %></td>
        <td><%= link_to 'View Merchant', union_pay_merchant %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Union Pay Merchant | ', new_union_pay_merchant_path %>
<%= link_to 'View All Union Pay Merchants | ', union_pay_merchants_path %>
<%= link_to 'View All Union Pay Banks', union_pay_banks_path %>
