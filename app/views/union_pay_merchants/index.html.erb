<p id="notice"><%= notice %></p>

<h1>Union Pay Merchants</h1>

<table>
  <thead>
    <tr>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @union_pay_merchants.each do |union_pay_merchant| %>
      <tr>
        <td><%= union_pay_merchant.merchant_name %><td>
        <td><%= link_to 'Show', union_pay_merchant %></td>
        <td><%= link_to 'Edit', edit_union_pay_merchant_path(union_pay_merchant) %></td>
        <td><%= link_to 'Delete', union_pay_merchant, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Union Pay Merchant', new_union_pay_merchant_path %>
