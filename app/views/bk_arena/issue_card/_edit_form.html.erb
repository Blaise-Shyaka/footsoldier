
<%= simple_form_for(@bk_arena_pre_registration) do |f| %>
  <%= f.error_notification %>
    <% if @bk_arena_pre_registration.errors.any? %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
        <%= f.error_notification message: @bk_arena_pre_registration.errors.full_messages[0] %>
      </div>
    <% end %>

  <div>
  <div><h4 class="my-6 text-4lg font-bold">1. CUSTOMER DETAILS</h4></div>
    <div class="field">
      <%= f.label "FIRST NAME", class: "block text-sm"%>
      <%= f.text_field :first_name,
        placeholder: "Malik",
        value: @bk_arena_pre_registration.first_name,
        disabled: true,
        class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 block text-sm my-4",
        autofocus: true%>
    </div>
    <div class="field">
      <%= f.label "SURNAME", class: "block text-sm"%>
      <%= f.text_field :last_name,
        placeholder: "KANEZA",
        value: @bk_arena_pre_registration.last_name,
        disabled: true,
        class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 block text-sm my-4",
        autofocus: true%>
    </div>
    <div class="field">
      <%= f.label "ID NUMBER / Passport number", class: "block text-sm"%>
      <%= f.text_field :id_number,
        placeholder: "1199000000000000 / PC009009",
        value: @bk_arena_pre_registration.id_number,
        disabled: true,
        class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 block text-sm my-4",
        autofocus: true%>
    </div>
    <div class="field">
      <%= f.label "MOBILE TEL No.", class: "block text-sm"%>
      <%= f.input_field :tel_no,
        placeholder: "0780000000",
        value: @bk_arena_pre_registration.tel_no,
        disabled: true,
        class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 block text-sm my-4",
        autofocus: true%>
    </div>
    <div class="field">
      <%= f.label "Issuing Branch", class: "block text-sm"%>
      <%= f.input_field :issuing_branch,
        collection: [ current_user.bk_arena_branch ],
        class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 block text-sm my-4",
        autofocus: true%>
    </div>
    <div class="field">
      <%= f.label "Issuing Promoter/Agent", class: "block text-sm"%>
      <%= f.input_field :authorized_by,
                    collection: [
                      ["#{current_user.first_name} #{current_user.last_name}", current_user.id],
                    ],
        class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 block text-sm my-4",
        autofocus: true%>
    </div>
    <div class="field">
      <%= f.label "Card First 4-digits", class: "block text-sm"%>
      <%= f.input_field :card_first_four_digits,
        placeholder: "4565",
        required: true,
        class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 block text-sm my-4",
        autofocus: true%>
    </div>
    <div class="field">
      <%= f.label "Card Last 4-digits", class: "block text-sm"%>
      <%= f.input_field :card_last_four_digits,
        placeholder: "0768",
        required: true,
        class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 block text-sm my-4",
        autofocus: true%>
    </div>
    
  <div class="form-actions">
    <%= f.button :submit, "Submit", class: "w-full px-8 py-3 rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %>
  </div><br>
<% end %>


