<h1 class="text-2xl font-bold text-center mt-10 leading-7 text-gray-900 sm:text-3xl sm:truncate">BK Arena Pre-Registrations Report</h1>

<div class="flex flex-col items-center">
  <div style="width:98%" class="overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="inline-block py-2 min-w-full sm:px-6 lg:px-8">
      <div class="overflow-hidden shadow-md sm:rounded-lg">
        <table class="min-w-full">
          <thead class="bg-gray-100 dark:bg-gray-700">
            <tr>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Client Full Name
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Phone Number
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Card Number
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Card Issuance Branch
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Promoter Name
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Bk Arena Agent Name
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Date
              </th>
            </tr>
          </thead>
          <tbody>
            <% @bk_arena_clients.each do |client| %>
              <tr class="border-b odd:bg-white even:bg-gray-50 odd:dark:bg-gray-800 even:dark:bg-gray-700 dark:border-gray-600">
                <td class="py-4 px-6 text-sm font-medium text-gray-900 dark:text-white">
                  <%= "#{client.first_name} #{client.last_name}" %>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= client.tel_no %>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= !client.card_first_four_digits || !client.card_last_four_digits ? "Card Not Yet Issued" : "#{client.card_first_four_digits} --- #{client.card_last_four_digits}" %>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= client.issuing_branch ? client.issuing_branch : "Card Not Yet Issued" %>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= "#{client.user.first_name} #{client.user.last_name}" %>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= client.authorized_by ? client.authorized_by : "Card Not Yet Issued" %>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= client.updated_at.to_date %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
