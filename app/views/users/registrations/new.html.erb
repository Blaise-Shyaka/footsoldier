<div class="flex flex-col items-center p-6 rounded-md sm:p-10 bg-gray-50 text-coolGray-800">
  <div class="bg-white p-8 w-4/5 lg:w-2/5 rounded-md">
    <div class="mb-8 text-center">
		  <h1 class="my-3 text-4xl font-bold">Sign Up</h1>
		  <p class="text-sm text-coolGray-600">Create your RG-Data account</p>
	  </div>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :first_name, class: "block text-sm"  %><br />
        <%= f.text_field :first_name, placeholder: "Jenkins", class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 text-coolGray-800", autofocus: true, autocomplete: "first_name" %>
      </div>

      <div class="field">
        <%= f.label :last_name, class: "block text-sm" %><br />
        <%= f.text_field :last_name, placeholder: "KEZA", class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 text-coolGray-800", autofocus: true, autocomplete: "last_name" %>
      </div>

      <div class="field">
        <%= f.label :telephone_number, class: "block text-sm" %><br />
        <%= f.telephone_field :telephone_number, placeholder: "0777444999", 
                              class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 text-coolGray-800", 
                              autofocus: true, 
                              autocomplete: "telephone_number",
                              input_html: { minlength: 10, maxlength: 10} %>
      </div>

      <div class="field">
        <%= f.label :email, class: "block text-sm" %><br />
        <%= f.email_field :email, placeholder: "keza@jenkins.com", class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 text-coolGray-800", autofocus: true, autocomplete: "email" %>
      </div>

      <div class="field">
        <%= f.label :password, class: "block text-sm" %>
        <% if @minimum_password_length %>
        <em>(<%= @minimum_password_length %> characters minimum)</em>
        <% end %><br />
        <%= f.password_field :password, placeholder: "********", class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 text-coolGray-800", autocomplete: "new-password" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, class: "block text-sm" %><br />
        <%= f.password_field :password_confirmation, placeholder: "********", class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 text-coolGray-800", autocomplete: "new-password" %>
      </div>

      <div class="actions">
        <%= f.submit "Sign up", class: "w-full px-8 py-3 rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %>
      </div>
      <p class="px-6 text-sm text-center text-coolGray-600">Already have an account? <%= render "users/shared/links" %> </p>
    <% end %>
  </div>
</div>

