<div class="flex flex-col items-center p-6 rounded-md sm:p-10 bg-gray-50 bg-coolGray-50 text-coolGray-800">
  <div class="bg-white p-8 w-4/5 lg:w-2/5 rounded-md">
    <div class="mb-8 text-center">
      <h2 class="my-3 text-2xl font-bold">Forgot your password?</h2>
	  </div>
    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= f.error_notification %>
    
      <div class="field">
      <%= f.label "Email", class: "block text-sm"%>
        <%= f.input_field :email,
                    required: true,
                    autofocus: true,
                    class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 block text-sm my-4",
                    input_html: { autocomplete: "email" } %>
      </div>
    
      <div class="form-actions">
        <%= f.button :submit, "Send me reset password instructions", class: "w-full px-8 py-3 rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %>
      </div>
    <% end %>
    
    <%= render "devise/shared/links" %>
  </div>
</div>
