<div class="flex flex-col items-center p-6 rounded-md sm:p-10 bg-gray-50 bg-coolGray-50 text-coolGray-800">
  <div class="bg-white p-8 w-4/5 lg:w-2/5 rounded-md">
    <div class="mb-8 text-center">
		  <h2 class="my-3 text-2xl font-bold">Change your password</h2>
	  </div>
    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.error_notification %>
    
      <%= f.input :reset_password_token, as: :hidden %>
      <%= f.full_error :reset_password_token %>
    
      <div class="form-inputs">
        <div class="field">
          <%= f.label "New Password", class: "text-sm"%>
          <%= f.input_field :password,
                      label: "New password",
                      required: true,
                      autofocus: true,
                      class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 block text-sm my-4",
                      hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                      input_html: { autocomplete: "new-password" } %>
        </div>
        <div class="field">
          <%= f.label "Confirm your new password", class: "text-sm"%>
          <%= f.input_field :password_confirmation,
                      label: "Confirm your new password",
                      required: true,
                      class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 block text-sm my-4",
                      input_html: { autocomplete: "new-password" } %>
        </div>
      </div>
    
      <div class="form-actions">
        <%= f.button :submit, "Change my password", class: "w-full px-8 py-3 rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %>
      </div>
    <% end %>
    
    <%= render "devise/shared/links" %>
  </div>
</div>
