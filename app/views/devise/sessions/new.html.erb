<div class="flex flex-col items-center p-6 rounded-md sm:p-10 bg-gray-50 bg-coolGray-50 text-coolGray-800">
  <div class="bg-white p-8 w-4/5 lg:w-2/5 rounded-md">
    <div class="mb-8 text-center">
		  <h1 class="my-3 text-4xl font-bold">Sign in</h1>
		  <p class="text-sm text-coolGray-600">Sign in to access your RG-Data account</p>
	  </div>
    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-inputs">
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "email", placeholder: "keza@jenkins.com", class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 block text-sm my-4" } %>
        <%= f.input :password,
                    required: false,
                    input_html: { autocomplete: "current-password", placeholder: "********", class: "w-full px-3 py-2 border rounded-md border-coolGray-300 bg-coolGray-50 block text-sm my-4" } %>
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
      </div>

      <div class="form-actions mt-4">
        <%= f.button :submit, "Log in", class: "w-full px-8 py-3 rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %>
      </div>
  <% end %>
  <p class="px-6 my-6 text-sm text-center text-coolGray-600">Already have an account? <%= render "users/shared/links" %> </p>
  </div>
</div>
