<h2>Approve User</h2>
<%= simple_form_for :approve_user, url: admin_approve_user_approve_user_path do |f| %>
  <%= f.input :email, required: true %>
  <%= f.input :is_promoter?,
              collection: [true, false],
              label: "Is Promoter?",
              required: true,
              prompt: "Select Option"%>
  <%= f.input :works_with_engen,
              collection: [true, false],
              label: "Promoter Works with ENGEN?",
              required: true,
              prompt: "Select Option"%>
  <%= f.input :works_with_upi_merchants,
              collection: [true, false],
              label: "Promoter Works with UPI Merchants?",
              required: true,
              prompt: "Select Option"%>
  <%= f.input :works_with_upi_banks,
              collection: [true, false],
              label: "Promoter Works with UPI Banks?",
              required: true,
              prompt: "Select Option"%>
  <%= f.input :works_with_bk_arena,
              collection: [true, false],
              label: "Promoter Works with BK Arena?",
              required: true,
              prompt: "Select Option"%>
  <%= f.input :bk_arena_admin,
              collection: [true, false],
              label: "Is BK Arena Admin?",
              required: true,
              prompt: "Select Option"%>
  <%= f.input :is_bk_arena_agent,
              collection: [true, false],
              label: "Is BK Arena Agent?",
              required: true,
              prompt: "Select Option"%>
  <%= f.input :bk_arena_branch,
              collection: [ 'BK Airport Branch',
              'BK DP world Branch',
              'BK Economic zone Branch',
              'BK Gikondo Branch',
              'BK Giporoso Branch',
              'BK Gisozi Branch',
              'BK Gkondo Magerwa Branch',
              'BK Head office Branch',
              'BK Kabuga Branch',
              'BK Kicukiro Branch',
              'BK Kigali City Market Branch',
              'BK Kigali height Branch',
              'BK Kimironko Branch',
              'BK Kinamba Branch',
              'BK MTN center Branch',
              'BK Nyabugogo Branch',
              'BK Nyamirambo Branch',
              'BK Pension Branch',
              'BK RDB Branch',
              'BK Remera corner Branch',
              'BK Town Branch' ],
              prompt: 'Select option' %>
  <%= f.input :admin_secret_key, required: true %>
  <%= f.button :submit %>
<% end %>