<div>
  <%= link_to 'Merchants Report', union_pay_reports_merchants_path, { style: 'color: white', class: "ml-4 text-white bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded focus:ring-gray-300"} %>
  <%= link_to 'ATMs/Banks Report', union_pay_reports_banks_path, { style: 'color: white', class: "ml-4 text-white bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded focus:ring-gray-300"} %>
  <%= link_to 'Merchants Report Analysis', union_pay_reports_merchants_analysis_path, { style: 'color: white', class: "ml-4 text-white bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded focus:ring-gray-300"} %>
  <%= link_to 'ATM/Banks Report Analysis', union_pay_reports_banks_analysis_path, { style: 'color: white', class: "ml-4 text-white bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded focus:ring-gray-300"} %>
  <%= link_to 'Download Merchants List', union_pay_reports_download_merchants_csv_path(format: "csv"), { style: 'color: white', class: "ml-4 text-white bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded focus:ring-gray-300"} %>
</div>

<h1 class="text-2xl font-bold text-center mt-10 leading-7 text-gray-900 sm:text-3xl sm:truncate">Union Pay Merchants Report</h1>

<div class="flex flex-col items-center">
  <div class="w-11/12 overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="inline-block py-2 min-w-full sm:px-6 lg:px-8">
      <div class="overflow-hidden shadow-md sm:rounded-lg">
        <table class="min-w-full">
          <thead class="bg-gray-100 dark:bg-gray-700">
            <tr>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Merchant Name
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Address
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Merchant Category
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Transaction Result
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Transaction Code
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Branding Status
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Special Comments
              </th>
            </tr>
          </thead>
          <tbody>
            <% @merchants.each do |merchant| %>
              <tr class="border-b odd:bg-white even:bg-gray-50 odd:dark:bg-gray-800 even:dark:bg-gray-700 dark:border-gray-600">
                <td class="py-4 px-6 text-sm font-medium text-gray-900 whitespace-nowrap dark:text-white">
                  <%= merchant.merchant_name %>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 whitespace-nowrap dark:text-gray-400">
                  <%= merchant.address %>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 whitespace-nowrap dark:text-gray-400">
                  <%= merchant.merchant_category %>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 whitespace-nowrap dark:text-gray-400">
                  <%= merchant.chip_in_pos_purchase_transaction_result %>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 whitespace-nowrap dark:text-gray-400">
                  <%= merchant.chip_in_pos_code %>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 whitespace-nowrap dark:text-gray-400">
                  <%= merchant.upi_decal_displayed_after_visit == 'Yes' ? 'Branded during visit' : 'Pre-branded' %>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 whitespace-nowrap dark:text-gray-400">
                  <%= merchant.special_comments %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
