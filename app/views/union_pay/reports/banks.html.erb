<p><%= link_to 'Merchants Report', union_pay_reports_merchants_path %> | <%= link_to 'ATMs/Banks Report', union_pay_reports_banks_path %></p>

<h1>Union Pay Banks/ATMs Report</h1>

<table>
  <thead>
    <tr>
      <th>Bank name</th>
      <th>Atm location</th>
      <th>Upi accepted</th>
      <th>Why test not allowed</th>
      <th>Transaction result</th>
      <th>Transaction code</th>
      <th>Upi decal displayed before visit</th>
      <th>Upi decal displayed after visit</th>
      <th>Is visa or mastercard displayed</th>
      <th>Special comments</th>
    </tr>
  </thead>

  <tbody>
    <% @banks.each do |union_pay_bank| %>
      <tr>
        <td><%= union_pay_bank.bank_name %></td>
        <td><%= union_pay_bank.atm_location %></td>
        <td><%= union_pay_bank.upi_accepted %></td>
        <td><%= union_pay_bank.why_test_not_allowed %></td>
        <td><%= union_pay_bank.transaction_result %></td>
        <td><%= union_pay_bank.transaction_code %></td>
        <td><%= union_pay_bank.upi_decal_displayed_before_visit %></td>
        <td><%= union_pay_bank.upi_decal_displayed_after_visit %></td>
        <td><%= union_pay_bank.is_visa_or_mastercard_displayed %></td>
        <td><%= union_pay_bank.special_comments %></td>
      </tr>
    <% end %>
  </tbody>
</table>