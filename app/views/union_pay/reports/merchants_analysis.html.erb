<div class="flex my-3">
  <%= link_to 'Merchants Report', union_pay_reports_merchants_path, { style: 'color: white', class: "ml-4 text-white bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded focus:ring-gray-300"} %>
  <%= link_to 'ATMs/Banks Report', union_pay_reports_banks_path, { style: 'color: white', class: "ml-4 text-white bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded focus:ring-gray-300"} %>
  <%= link_to 'Merchants Report Analysis', union_pay_reports_merchants_analysis_path, { style: 'color: rgb(79, 70, 229); hover:color:white', class: "ml-4 bg-white border-solid border-2 border-indigo-600 hover:bg-indigo-700 font-bold py-2 px-4 rounded focus:ring-gray-300"} %>
  <%= link_to 'ATM/Banks Report Analysis', union_pay_reports_banks_analysis_path, { style: 'color: white', class: "ml-4 text-white bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded focus:ring-gray-300"} %>
</div>

<h1 class="text-2xl font-bold text-center mt-10 leading-7 text-gray-900 sm:text-3xl sm:truncate">Merchants Report Analysis</h1>

<div class="flex flex-col items-center">
  <div style="width:98%" class="overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="inline-block py-2 min-w-full sm:px-6 lg:px-8">
      <div class="overflow-hidden shadow-md sm:rounded-lg">
        <table class="min-w-full">
          <thead class="bg-gray-100 dark:bg-gray-700">
            <tr>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Total number of merchants visited
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who accept international payments
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who accept UPI Cards - Test was not allowed
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who accept UPI Cards - Test allowed
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of tests where transaction result is "Approved"
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who accept ONLY VISA
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who accept ONLY Mastercard
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who accept both VISA and Mastercard
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who had UPI physical decal displayed before this exercise
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who had UPI electronic decal displayed before this exercise
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who displayed UPI decal after this exercise
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who have ONLY VISA decal displayed
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who have ONLY Mastercard decal displayed
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who have both VISA and Mastercard decal displayed
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who have UPI contactless mark shown on the decal
              </th>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Number of merchants who have both VISA and Mastercard contactless mark shown on the decal
              </th>
            </tr>
          </thead>
          <tbody>
              <tr class="border-b odd:bg-white even:bg-gray-50 odd:dark:bg-gray-800 even:dark:bg-gray-700 dark:border-gray-600">
                <td class="py-4 px-6 text-sm font-medium text-gray-900 dark:text-white">
                  <%= UnionPayMerchant.all.length%>
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @merchants_accepting_international_payments %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @merchant_accept_upi_cards_test_not_allowed %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @merchant_accept_upi_cards_test_allowed %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @transactions_with_approved_result %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @merchants_accepting_visa_only %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @merchants_accepting_mastercard_only %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @merchants_accepting_both_visa_and_mastercard %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @physical_decal_displayed_before_campaign %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @electronic_decal_displayed_before_campaign %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @upi_decal_displayed_after_visit %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @only_visa_decal_displayed %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @only_mastercard_decal_displayed %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @both_visa_and_mastercard_decal_displayed %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @upi_contactless_on_decal %>%
                </td>
                <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                  <%= @both_visa_and_mastercard_contactless_on_decal %>%
                </td>
              </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<h3 class="text-lg font-bold text-center mt-10 leading-7 text-gray-900 sm:text-3xl sm:truncate">Approved Transactions - Response Codes Breakdown</h1>

<div class="flex flex-col items-center">
  <div style="width:98%" class="overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="inline-block py-2 min-w-full sm:px-6 lg:px-8">
      <div class="overflow-hidden shadow-md sm:rounded-lg">
        <table class="min-w-full">
          <thead class="bg-gray-100 dark:bg-gray-700">
            <tr>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Transaction Result/Transaction Code
              </th>
              <% @approved_transactions_codes.keys.each do |key| %>
                <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                  <%= key.length.zero? ? 'No Code' : key %>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
              <tr class="border-b odd:bg-white even:bg-gray-50 odd:dark:bg-gray-800 even:dark:bg-gray-700 dark:border-gray-600">
                <td class="py-4 px-6 text-sm font-medium text-gray-900 dark:text-white">
                  Approved
                </td>
                <% @approved_transactions_codes.values.each do |code| %>
                  <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                    <%= code %>
                  </td>
                <% end %>
              </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<h3 class="text-lg font-bold text-center mt-10 leading-7 text-gray-900 sm:text-3xl sm:truncate">Failed Transactions - Response Codes Breakdown</h1>

<div class="flex flex-col items-center">
  <div style="width:98%" class="overflow-x-auto sm:-mx-6 lg:-mx-8">
    <div class="inline-block py-2 min-w-full sm:px-6 lg:px-8">
      <div class="overflow-hidden shadow-md sm:rounded-lg">
        <table class="min-w-full">
          <thead class="bg-gray-100 dark:bg-gray-700">
            <tr>
              <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                Transaction Result/Transaction Code
              </th>
              <% @failed_transactions_codes.keys.each do |key| %>
                <th scope="col" class="py-3 px-6 text-xs font-medium tracking-wider text-left text-gray-700 uppercase dark:text-gray-400">
                  <%= key.length.zero? ? 'No Code' : key %>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody>
              <tr class="border-b odd:bg-white even:bg-gray-50 odd:dark:bg-gray-800 even:dark:bg-gray-700 dark:border-gray-600">
                <td class="py-4 px-6 text-sm font-medium text-gray-900 dark:text-white">
                  Failed
                </td>
                <% @failed_transactions_codes.values.each do |code| %>
                  <td class="py-4 px-6 text-sm text-gray-500 dark:text-gray-400">
                    <%= code %>
                  </td>
                <% end %>
              </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>