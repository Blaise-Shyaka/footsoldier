<h1>ATMs/Banks Report Analysis</h1>

<table>
  <thead>
    <tr>
      <th>Number of banks visited</th>
      <th>% of ATMs accepting UPI Cards</th>
      <th>% of Banks who denied testing their ATMs</th>
      <th>% of transactions with 'Approved' as a result</th>
      <th>% of transactions with 'Failed' as a result</th>
      <th>% of banks who had UPI physical decal displayed before this exercise</th>
      <th>% of banks who had UPI electronic decal displayed before this exercise</th>
      <th>% of banks who had NO UPI decal displayed before this exercise</th>
      <th>% of banks who displayed UPI decal after this exercise</th>
      <th>% of banks who have VISA and Mastercard decal displayed</th>
    </tr>
  </thead>

  <tbody>
      <tr>
        <td><%= @total_nber_of_banks %></td>
        <td><%= @atms_accepting_upi_cards %>%</td>
        <td><%= @atms_where_test_not_allowed %>%</td>
        <td><%= @atms_where_transaction_is_approved %>%</td>
        <td><%= @atms_where_transaction_is_failed %>%</td>
        <td><%= @atms_pysical_decal_is_displayed_before_visit %>%</td>
        <td><%= @atms_electronic_decal_is_displayed_before_visit %>%</td>
        <td><%= @atms_no_decal_is_displayed_before_visit %>%</td>
        <td><%= @atms_decal_displayed_after_visit %>%</td>
        <td><%= @visa_and_mastercard_decal_displayed %>%</td>
      </tr>
  </tbody>
</table>

