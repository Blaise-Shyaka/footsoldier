#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

# psql on the maintenance database, as libpq's default role: normally your OS user.
def psql(*args)
  [ "psql", "--dbname=postgres", "--no-psqlrc", "--set=ON_ERROR_STOP=1", *args ]
end

# The local databases in config/database.yml that belong to another role than footsoldier_owner.
FOREIGN_DATABASES = <<~SQL
  SELECT datname FROM pg_database
  WHERE datname IN ('footsoldier_development', 'footsoldier_test')
    AND datdba <> 'footsoldier_owner'::regrole
  ORDER BY datname
SQL

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # Install JavaScript dependencies
  system("yarn install --check-files")

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  puts "\n== Creating database roles =="
  # Rails migrates as footsoldier_owner and runs as footsoldier_app ("Database roles" in README.md).
  system(*psql("--quiet", "--file=db/roles.sql")) || abort(<<~MESSAGE)
    Could not create the footsoldier_owner and footsoldier_app roles. db/roles.sql must run as a
    PostgreSQL superuser. If your OS user is not one, run the file as one, then bin/setup again:

      sudo -u postgres psql --dbname=postgres < db/roles.sql
  MESSAGE

  # Databases made before the roles existed belong to your OS user, so footsoldier_owner can
  # neither migrate nor recreate them.
  foreign = IO.popen(psql("--tuples-only", "--no-align", "--command=#{FOREIGN_DATABASES}"), &:read).split
  if foreign.any?
    abort <<~MESSAGE
      These databases belong to another role than footsoldier_owner, probably because they were
      created before the database roles existed. If nothing in them needs keeping, drop them and
      run bin/setup again:

      #{foreign.map { |name| "  dropdb #{name}" }.join("\n")}
    MESSAGE
  end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
